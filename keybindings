macos-option-as-alt = true

keybind = alt+shift+==new_split:right
keybind = alt+shift+-=new_split:down

keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+l=goto_split:right

keybind = cmd+shift+alt+[=move_tab:-1
keybind = cmd+shift+alt+]=move_tab:1

keybind = alt+cmd+k=scroll_page_lines:-1
keybind = alt+cmd+j=scroll_page_lines:1
